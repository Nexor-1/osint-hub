# OSINT Hub configuration. Copy to ".env" next to OSINTHub.exe (or the repo root),
# or to %APPDATA%\OSINTHub\.env. Values here override keys saved in Settings
# (which are stored in Windows Credential Manager). Never commit a real .env.

# --- paths (optional) ---
# OSINTHUB_DATA_DIR=D:\OSINTHubData
# OSINTHUB_TOOLS_DIR=D:\OSINTHub\tools

# --- PhoneInfoga ---
NUMVERIFY_API_KEY=
GOOGLE_API_KEY=
GOOGLECSE_CX=

# --- SpiderFoot modules ---
SF_SHODAN_API_KEY=
SF_HIBP_API_KEY=
SF_HUNTER_API_KEY=
SF_SECURITYTRAILS_API_KEY=
SF_VIRUSTOTAL_API_KEY=
SF_IPINFO_API_KEY=
SF_EMAILREP_API_KEY=
